---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingLink from '../components/BookingLink.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import { business } from '../data/business.js';
const configuredForm = /^https:\/\/formspree\.io\/f\/[\w-]+$/.test(business.formEndpoint);
const firstService = business.services[0];
---
<BaseLayout title={business.seoTitle} businessName={business.name} lang={business.locale} description={`${business.description} Book your visit at ${business.name} in ${business.location}.`}>
  <div class="demo-banner">DEMONSTRATION TEMPLATE · Sample business, prices, testimonials, images and contact details — not a real salon.</div>
  <div class="announcement"><span>{business.location.toUpperCase()}</span><span>{business.tagline} <i>✳</i></span></div>
  <header class="site-header wrap">
    <a class="wordmark" href="#top" aria-label={`${business.name} home`}><span class="wordmark-icon">{business.logo ? <img src={business.logo} alt="" /> : 's.'}</span><span>{business.name}<small>{business.brandLabel}</small></span></a>
    <nav aria-label="Main navigation"><a href="#services">Services</a><a href="#about">Our story</a><a href="#gallery">The details</a><a href="#visit">Visit</a></nav>
    <BookingLink business={business} />
  </header>
  <main id="top">
    <section class="hero wrap">
      <div class="hero-copy"><div class="eyebrow"><span class="line"></span> YOUR NEIGHBOURHOOD BEAUTY STUDIO</div><h1>{business.headline}</h1><p class="hero-lead">{business.description}</p><div class="hero-actions"><BookingLink business={business} service={firstService.name} /><a class="text-link" href="#services">Explore our services <span aria-hidden="true">↓</span></a></div><div class="hero-note"><span class="stars">★★★★★</span><span>A little love from our lovely guests</span></div></div>
      <div class="hero-visual"><img src={business.heroImage.src} alt={business.heroImage.alt} fetchpriority="high" /><div class="image-caption"><span>01 / 03</span><span>Small rituals. Lovely results.</span></div><div class="roundel"><span>MADE FOR<br />YOUR MOMENT</span><b>✳</b></div></div>
      <div class="hero-bottom"><span>GOOD BEAUTY, GOOD FEELING.</span><a href="#services">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
    </section>

    <section id="services" class="services section-pad"><div class="wrap"><div class="section-heading"><div><div class="eyebrow"><span class="line"></span> CONSIDER THIS YOUR TIME</div><h2>A little care<br /><em>goes a long way.</em></h2></div><p>Beautifully considered treatments, a gentle pace, and the little details that make all the difference.</p></div><div class="service-list">{business.services.map((service, i) => <article class="service-row"><div class="service-index">0{i + 1}</div><div class="service-main"><span class="service-category">{service.category} · {service.duration}</span><h3>{service.name}</h3><p>{service.detail}</p></div><div class="service-price">{business.currency}{service.price}</div><BookingLink business={business} service={service.name} /></article>)}</div><p class="fine-print">All prices are a guide and confirmed at your appointment. Please let us know about any sensitivities when booking.</p></div></section>

    <section id="gallery" class="gallery section-pad"><div class="wrap"><div class="gallery-heading"><div><div class="eyebrow"><span class="line"></span> A FEW LITTLE FAVOURITES</div><h2>Made with care.<br /><em>Worn with joy.</em></h2></div><span class="gallery-aside">A glimpse of what we do<br />and how we do it.</span></div><div class="gallery-grid">{business.gallery.map((image, i) => <figure class={`gallery-item gallery-item-${i + 1}`}><img src={image.src} alt={image.alt} loading="lazy" /><figcaption><span>{image.label}</span><span>0{i + 1}</span></figcaption></figure>)}</div></div></section>

    <section id="about" class="about section-pad"><div class="wrap about-grid"><div class="about-image"><img src={business.aboutImage.src} alt={business.aboutImage.alt} loading="lazy" /><span class="image-stamp">A SPACE<br />TO EXHALE <b>✳</b></span></div><div class="about-copy"><div class="eyebrow"><span class="line"></span> A NOTE FROM US</div><h2>Beauty should feel<br /><em>like coming home.</em></h2><p>{business.about}</p><div class="signature"><span>With love,</span><strong>{business.name}</strong></div><a class="text-link" href="#visit">Come say hello <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="testimonials section-pad"><div class="wrap"><div class="testimonial-title"><div class="eyebrow"><span class="line"></span> KIND WORDS, KEPT CLOSE</div><h2>We're blushing.<br /><em>And it's not just the polish.</em></h2></div><div class="quote-grid">{business.testimonials.map((review) => <blockquote><div class="stars" aria-label="5 out of 5 stars">★★★★★</div><p>“{review.quote}”</p><footer><span class="quote-avatar">{review.name.slice(0, 1)}</span><span><strong>{review.name}</strong><small>{review.detail}</small></span></footer></blockquote>)}</div></div></section>

    <section id="booking" class="booking section-pad"><div class="wrap booking-grid"><div class="booking-copy"><div class="eyebrow"><span class="line"></span> LET'S MAKE A LITTLE TIME</div><h2>Your next<br /><em>good thing.</em></h2><p>Tell us what you're after and when you'd love to visit. We'll be in touch to confirm a time that works.</p><div class="booking-ways"><a href={`mailto:${business.email}`}><span class="way-icon">✉</span><span><small>EMAIL US</small><strong>{business.email}</strong></span></a>{business.whatsappNumber ? <a href={`https://wa.me/${business.whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(business.whatsappGreeting)}`} target="_blank" rel="noopener noreferrer"><span class="way-icon">↗</span><span><small>WHATSAPP</small><strong>Send us a message</strong></span></a> : <div class="booking-way-disabled"><span class="way-icon">↗</span><span><small>WHATSAPP</small><strong>Configure a number to enable</strong></span></div>}{business.phone && <a href={`tel:${business.phone.replace(/[^+\d]/g, '')}`}><span class="way-icon">☎</span><span><small>CALL US</small><strong>{business.phone}</strong></span></a>}</div></div>
      <div class="form-card"><div class="form-heading"><span>APPOINTMENT REQUEST</span><span>01 — 07</span></div>
        <AppointmentForm business={business} configuredForm={configuredForm} />
    </div></div></section>

    <section id="visit" class="visit section-pad"><div class="wrap visit-grid"><div><div class="eyebrow"><span class="line"></span> YOUR LITTLE CORNER OF THE CITY</div><h2>Come as you are.<br /><em>We'll put the kettle on.</em></h2><p class="visit-address">{business.address}<br />{business.location}</p><a class="text-link" href={`https://maps.google.com/?q=${encodeURIComponent(business.address)}`} target="_blank" rel="noopener noreferrer">Find us on the map <span aria-hidden="true">↗</span></a></div><div class="hours-card"><h3>When we're here</h3>{business.hours.map(([day, time]) => <div class="hours-row"><span>{day}</span><span>{time}</span></div>)}<p>{business.hoursNote}</p></div></div></section>
  </main>
  <footer class="site-footer"><div class="wrap footer-top"><a class="wordmark footer-mark" href="#top"><span class="wordmark-icon">{business.logo ? <img src={business.logo} alt="" /> : 's.'}</span><span>{business.name}<small>{business.brandLabel}</small></span></a><p>{business.tagline}<br />Made with love in {business.location}.</p><div class="footer-social">{business.social.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer">{social.label} ↗</a>)}</div><a class="back-top" href="#top" aria-label="Back to top">↑</a></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {business.name}. All rights reserved.</span><div class="footer-contacts"><a href={`mailto:${business.email}`}>{business.email}</a>{business.phone && <a href={`tel:${business.phone.replace(/[^+\d]/g, '')}`}>{business.phone}</a>}{business.privacyUrl ? <a href={business.privacyUrl}>Privacy policy</a> : <a href={`mailto:${business.email}?subject=${encodeURIComponent('Privacy enquiry')}`}>Privacy enquiries</a>}</div>{business.siteCredit && <span>Website by {business.siteCredit}</span>}</div></footer>
</BaseLayout>
